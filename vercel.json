{
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/terms", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/refund", "destination": "/" },
    { "source": "/pricing", "destination": "/" },
    { "source": "/practice", "destination": "/" },
    { "source": "/progress", "destination": "/" },
    { "source": "/toolkit", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/grammar", "destination": "/" }
  ]
}
